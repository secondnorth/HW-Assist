page {
  background: #000;
  color: #fff;
}

.wrap {
  position: relative;
  width: 100%;
}

.cam {
  width: 100%;
}

.denied {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.denied-text {
  color: #bbb;
  margin-bottom: 24rpx;
}

.denied-btn {
  width: 240rpx;
}

.strip {
  box-sizing: border-box;
  width: 100%;
  white-space: nowrap;
  background: #111;
  padding: 10px 12px;
}

.strip-empty {
  line-height: 56px;
  color: #777;
  font-size: 24rpx;
}

.shot {
  width: 56px;
  height: 56px;
  margin-right: 8px;
  border-radius: 6px;
  background: #222;
}

.bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 40rpx;
  padding-right: 40rpx;
  background: #000;
}

.side {
  width: 160rpx;
  font-size: 30rpx;
  color: #fff;
}

.side.done {
  text-align: right;
  color: #07c160;
}

.n {
  font-size: 26rpx;
}

.shutter {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #fff;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.shutter-in {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: #fff;
}

.hover {
  opacity: 0.6;
}
