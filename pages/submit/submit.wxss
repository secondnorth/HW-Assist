/* 第【】周 */
.num-row {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 96rpx;
}

.num-text {
  font-size: 40rpx;
  font-weight: 600;
}

.num-input {
  width: 128rpx;
  height: 72rpx;
  margin: 0 16rpx;
  text-align: center;
  font-size: 40rpx;
  font-weight: 600;
  border: 1rpx solid #ccc;
  border-radius: 12rpx;
}

/* 滚轮 */
.wheel {
  height: 240rpx;
  margin: 8rpx 0 12rpx;
}

.wheel-item {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  white-space: nowrap;
}

.wheel-text {
  font-size: 32rpx;
}

.wheel-date {
  margin-left: 16rpx;
  font-size: 24rpx;
  font-style: italic;
  color: #b5b5b5;
}

/* 照片区 */
.card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.head-title {
  margin-bottom: 0;
}

.select-all {
  font-size: 28rpx;
  padding: 8rpx 0 8rpx 24rpx;
}

.tools {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin: 20rpx 0 16rpx;
}

.tool {
  min-width: 140rpx;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: 26rpx;
  color: #333;
  border: 1rpx solid #d9d9d9;
  border-radius: 10rpx;
}

.tool.main {
  color: #fff;
  background: #07c160;
  border-color: #07c160;
}

.tool.danger {
  color: #d9382c;
  border-color: #efb6b1;
}

.tool.disabled {
  opacity: 0.4;
}

.tool-hover {
  opacity: 0.6;
}

.sel-count {
  margin-bottom: 8rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 12rpx;
}

.cell {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  margin: 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.thumb {
  width: 100%;
  height: 100%;
  transition: transform 0.2s;
}

.page-no {
  position: absolute;
  z-index: 2;
  left: 0;
  top: 0;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-bottom-right-radius: 12rpx;
}

/* 批量编辑时右上角的选择方框 */
.check {
  position: absolute;
  z-index: 3;
  right: 10rpx;
  top: 10rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 42rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  border: 2rpx solid #fff;
  border-radius: 8rpx;
  background: rgba(0, 0, 0, 0.25);
  box-sizing: border-box;
}

.check.on {
  background: #07c160;
  border-color: #07c160;
}

.cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  background: #fff;
}

.plus {
  font-size: 56rpx;
  color: #999;
  line-height: 64rpx;
}

.tip {
  margin-bottom: 8rpx;
}

.switch-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filename {
  word-break: break-all;
  background: #f5f6f8;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.warn {
  color: #d9822b;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.btn-row button {
  flex: 1;
}

.center {
  text-align: center;
  margin-top: 24rpx;
}
