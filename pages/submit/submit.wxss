.num-wrap {
  display: flex;
  align-items: center;
}

.num-input {
  width: 140rpx;
  height: 72rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  border: 1rpx solid #ddd;
  border-radius: 12rpx;
  margin-right: 12rpx;
}

.wheel {
  height: 240rpx;
  margin: 8rpx 0 12rpx;
}

.wheel-item {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx 12rpx;
}

.cell {
  position: relative;
  width: 210rpx;
  height: 210rpx;
  margin: 8rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #f2f3f5;
}

.thumb {
  width: 100%;
  height: 100%;
  transition: transform 0.2s;
}

.page-no {
  position: absolute;
  z-index: 2;
  left: 0;
  top: 0;
  background: rgba(0, 0, 0, 0.55);
  color: #fff;
  font-size: 22rpx;
  padding: 2rpx 12rpx;
  border-bottom-right-radius: 12rpx;
}

.cell.add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #ccc;
  background: #fff;
}

.plus {
  font-size: 56rpx;
  color: #999;
  line-height: 64rpx;
}

.tip {
  margin-bottom: 8rpx;
}

.switch-row {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f0f0;
}

.filename {
  word-break: break-all;
  background: #f5f6f8;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.warn {
  color: #d9822b;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  margin-top: 16rpx;
}

.btn-row button {
  flex: 1;
}

.center {
  text-align: center;
  margin-top: 24rpx;
}
