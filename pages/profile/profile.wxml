<view class="page">
  <view class="card">
    <view class="row">
      <text class="label">姓名</text>
      <input class="input" placeholder="请输入姓名" maxlength="20" value="{{name}}" bindinput="onNameInput" />
    </view>
    <view class="row">
      <text class="label">学号</text>
      <input class="input" placeholder="请输入学号" maxlength="20" value="{{studentId}}" bindinput="onIdInput" />
    </view>
  </view>
  <!-- <view class="hint tip">只需填写一次，之后会自动用来给 PDF 命名。信息保存在这个微信账号的小程序里，不用每次输入。</view> -->
  <button class="btn-primary" bindtap="save">保存</button>
</view>
