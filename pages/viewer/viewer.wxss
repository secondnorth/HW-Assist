page {
  background: #000;
  color: #fff;
}

.viewer {
  width: 100%;
}

.stage {
  width: 100%;
  background: #000;
}

.pic {
  position: absolute;
  left: 50%;
  top: 50%;
}

.bar {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: #111;
}

.count {
  color: #aaa;
  font-size: 28rpx;
}

.edit-btn {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 44rpx;
  border-radius: 10rpx;
  background: #07c160;
  color: #fff;
  font-size: 30rpx;
}

.edit-hover {
  opacity: 0.7;
}
