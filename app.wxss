page {
  background: #f5f6f8;
  color: #222;
  font-size: 28rpx;
  box-sizing: border-box;
}

.page {
  padding: 24rpx;
  padding-bottom: 80rpx;
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72rpx;
}

.label {
  color: #888;
  width: 160rpx;
  flex-shrink: 0;
}

.input {
  flex: 1;
  text-align: right;
  height: 72rpx;
}

.btn-primary {
  background: #07c160;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
}

.btn-primary[disabled] {
  background: #9fdcbb;
  color: #fff;
}

.btn-plain {
  background: #fff;
  color: #07c160;
  border: 1rpx solid #07c160;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.link {
  color: #576b95;
  font-size: 26rpx;
}

.underline {
  text-decoration: underline;
}

.hint {
  color: #999;
  font-size: 24rpx;
}
